<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  
  <ItemDefinitionGroup>
    <JsonSchema>
      <Namespace>$(RootNamespace)</Namespace>
      <JsonLibrary>SystemTextJson</JsonLibrary>
      <!-- NJsonSchema only emits [JsonStringEnumMemberName] (the attribute
           System.Text.Json's JsonStringEnumConverter actually reads for a
           schema enum's declared string values) when this is >= 9.0; below
           that it emits only the legacy (Newtonsoft-era) [EnumMember],
           which System.Text.Json silently ignores, so a generated enum
           property round-trips as the C# member name instead of the
           schema's value (e.g. "Info" instead of "info"). -->
      <JsonLibraryVersion>10.0</JsonLibraryVersion>
      <!-- Comma-separated type names (matching whatever name NSwag would
           otherwise derive for a $ref'd schema - see the naming note next
           to a schema file that uses this) already generated by another
           <JsonSchema> item in this same project; the generator emits a
           bare reference to that name instead of redefining it, so two
           schemas that both $ref a shared file (e.g. device_logs.json) can
           coexist in one project/namespace without a duplicate-type
           compile error. Empty by default - most schemas need nothing
           excluded. -->
      <ExcludedTypeNames></ExcludedTypeNames>
    </JsonSchema>
  </ItemDefinitionGroup>

  <ItemGroup>
    <Compile Remove="@(JsonSchema->'%(OutputFile)')" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="@(JsonSchema->'%(OutputFile)')">
      <DependentUpon>%(JsonSchema.Link)</DependentUpon>
      <AutoGen>true</AutoGen>
      <DesignTime>true</DesignTime>
    </Compile>
  </ItemGroup>

  <Target Name="GenerateJsonSchemaCode"
          BeforeTargets="CoreCompile"
          Inputs="@(JsonSchema)"
          Outputs="@(JsonSchema->'%(OutputFile)')">

    <PropertyGroup>
      <NSwagInvoker Condition="'$(OS)' == 'Windows_NT'">$(NSwagExe)</NSwagInvoker>
      <NSwagInvoker Condition="'$(OS)' != 'Windows_NT'">$(NSwagExe_Net100)</NSwagInvoker>
    </PropertyGroup>

    <Message Text="JsonSchema input: %(JsonSchema.Identity). Output file: %(JsonSchema.OutputFile). Name: %(JsonSchema.ClassName). Library %(JsonSchema.JsonLibrary)" Importance="High" />

    <Exec Command="$(NSwagInvoker) jsonschema2csclient /input:%(JsonSchema.Identity) /output:%(JsonSchema.OutputFile) /namespace:%(JsonSchema.Namespace) /name:%(JsonSchema.ClassName) /jsonlibrary:%(JsonSchema.JsonLibrary) /jsonLibraryVersion:%(JsonSchema.JsonLibraryVersion) /excludedTypeNames:%(JsonSchema.ExcludedTypeNames)" ConsoleToMSBuild="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="OutputOfExec" />
    </Exec>
  </Target>

  <Target Name="ForceJsonSchemaCodeReGenerationOnRebuild"
          AfterTargets="CoreClean">
    <Delete Files="@(JsonSchema->'%(OutputFile)')" />
  </Target>
</Project>