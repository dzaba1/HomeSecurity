<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  
  <ItemDefinitionGroup>
    <JsonSchema>
      <Namespace>$(RootNamespace)</Namespace>
      <JsonLibrary>SystemTextJson</JsonLibrary>
    </JsonSchema>
  </ItemDefinitionGroup>

  <ItemGroup>
    <Compile Remove="@(JsonSchema->'%(OutputFile)')" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="@(JsonSchema->'%(OutputFile)')">
      <DependentUpon>%(JsonSchema.Link)</DependentUpon>
      <AutoGen>true</AutoGen>
      <DesignTime>true</DesignTime>
    </Compile>
  </ItemGroup>

  <Target Name="GenerateJsonSchemaCode"
          BeforeTargets="CoreCompile"
          Inputs="@(JsonSchema)"
          Outputs="@(JsonSchema->'%(OutputFile)')">

    <PropertyGroup>
      <NSwagInvoker Condition="'$(OS)' == 'Windows_NT'">$(NSwagExe)</NSwagInvoker>
      <NSwagInvoker Condition="'$(OS)' != 'Windows_NT'">$(NSwagExe_Net100)</NSwagInvoker>
    </PropertyGroup>

    <Message Text="JsonSchema input: %(JsonSchema.Identity). Output file: %(JsonSchema.OutputFile). Name: %(JsonSchema.ClassName). Library %(JsonSchema.JsonLibrary)" Importance="High" />

    <Exec Command="$(NSwagInvoker) jsonschema2csclient /input:%(JsonSchema.Identity) /output:%(JsonSchema.OutputFile) /namespace:%(JsonSchema.Namespace) /name:%(JsonSchema.ClassName) /jsonlibrary:%(JsonSchema.JsonLibrary)" ConsoleToMSBuild="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="OutputOfExec" />
    </Exec>
  </Target>

  <Target Name="ForceJsonSchemaCodeReGenerationOnRebuild"
          AfterTargets="CoreClean">
    <Delete Files="@(JsonSchema->'%(OutputFile)')" />
  </Target>
</Project>