{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LogBatchMessage",
  "type": "object",
  "required": ["messageId", "tenantId", "deviceId", "devices"],
  "properties": {
    "messageId": {
      "type": "string",
      "format": "uuid",
      "description": "Idempotency key for the consuming worker's Redis SETNX check."
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "deviceId": {
      "type": "string",
      "format": "uuid",
      "description": "The agent credential's own id, not a network device."
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "device_logs.json" }
    }
  },
  "additionalProperties": false
}
