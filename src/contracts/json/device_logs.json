{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeviceLogs",
  "description": "The log lines pertaining to one network device, observed in a single upload.",
  "type": "object",
  "required": ["device", "events"],
  "properties": {
    "device": {
      "$ref": "network_device.json"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "log_entry.json" }
    }
  },
  "additionalProperties": false
}
