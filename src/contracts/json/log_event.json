{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IngestLogsRequest",
  "type": "object",
  "required": [
    "events"
  ],
  "properties": {
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/LogEvent"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "LogEvent": {
      "type": "object",
      "required": [
        "eventId",
        "homeId",
        "deviceId",
        "level",
        "message"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid",
          "description": "Unique event identifier for idempotency"
        },
        "homeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "level": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warning",
            "error",
            "critical"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "additionalProperties": false
    }
  }
}