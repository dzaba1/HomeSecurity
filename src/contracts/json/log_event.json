{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IngestLogsRequest",
  "type": "object",
  "required": ["devices"],
  "properties": {
    "devices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "device_logs.json" },
      "description": "One entry per network device the agent observed since its last upload, each carrying the log lines that pertain to it."
    }
  },
  "additionalProperties": false
}
