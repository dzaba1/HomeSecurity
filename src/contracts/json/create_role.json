{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateRole",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 64, "description": "Name of the role" },
    "permissionKeys": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Permission catalog keys to grant this role"
    }
  },
  "required": ["name", "permissionKeys"],
  "additionalProperties": false
}
