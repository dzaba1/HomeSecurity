# Shape of src/.env, which is generated locally by init.ps1 and never
# committed. Run `pwsh ./init.ps1` from this folder before `docker compose up`.

POSTGRES_KEYCLOAK_DB=keycloak
POSTGRES_KEYCLOAK_USER=keycloak
POSTGRES_KEYCLOAK_PASSWORD=<generated-by-init.ps1>

POSTGRES_APP_DB=homesecurity
POSTGRES_APP_USER=homesecurity
POSTGRES_APP_PASSWORD=<generated-by-init.ps1>

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<generated-by-init.ps1>

RABBITMQ_DEFAULT_USER=homesecurity
RABBITMQ_DEFAULT_PASS=<generated-by-init.ps1>

# Symmetric key the Logs Ingestion API validates device JWTs against.
LOGS_DEVICE_TOKENS_SIGNING_KEY=<generated-by-init.ps1>

# Symmetric key the Devices API validates device JWTs against (agent
# router-config endpoint). A separate key from the Logs Ingestion one.
DEVICES_DEVICE_TOKENS_SIGNING_KEY=<generated-by-init.ps1>

# Must match the "oauth2-proxy" client secret rendered into
# config/keycloak/realm-export.json.
OAUTH2_PROXY_CLIENT_SECRET=<generated-by-init.ps1>
OAUTH2_PROXY_COOKIE_SECRET=<generated-by-init.ps1>

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<generated-by-init.ps1>
