<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- router_protocol.json/router_auth_mode.json are "library" schemas:
         shared by router.json, create_router.json and update_router.json via
         $ref, so each is generated exactly once here and the schemas that
         reference them exclude them (see build/JsonSchema.targets'
         ExcludedTypeNames note) rather than each regenerating its own copy,
         which would collide as duplicate types in this shared namespace.
         Class names carry the filename's snake_case through (Router_protocol)
         for the same reason as LogsIngestion.Contracts' network_device.json. -->
    <JsonSchema Include="..\..\..\contracts\json\router_protocol.json" Link="router_protocol.json" OutputFile="Router_protocol.cs" ClassName="Router_protocol" />
    <JsonSchema Include="..\..\..\contracts\json\router_auth_mode.json" Link="router_auth_mode.json" OutputFile="Router_auth_mode.cs" ClassName="Router_auth_mode" />
    <JsonSchema Include="..\..\..\contracts\json\router.json" Link="router.json" OutputFile="Router.cs" ClassName="Router" ExcludedTypeNames="Router_protocol,Router_auth_mode" />
    <JsonSchema Include="..\..\..\contracts\json\create_router.json" Link="create_router.json" OutputFile="CreateRouter.cs" ClassName="CreateRouter" ExcludedTypeNames="Router_protocol,Router_auth_mode" />
    <JsonSchema Include="..\..\..\contracts\json\update_router.json" Link="update_router.json" OutputFile="UpdateRouter.cs" ClassName="UpdateRouter" ExcludedTypeNames="Router_protocol,Router_auth_mode" />
    <JsonSchema Include="..\..\..\contracts\json\router_changed_message.json" Link="router_changed_message.json" OutputFile="RouterChangedMessage.cs" ClassName="RouterChangedMessage" />
    <JsonSchema Include="..\..\..\contracts\json\router_config.json" Link="router_config.json" OutputFile="RouterConfig.cs" ClassName="RouterConfig" ExcludedTypeNames="Router_protocol,Router_auth_mode" />

    <!-- Same "library schema" treatment for device_status.json. -->
    <JsonSchema Include="..\..\..\contracts\json\device_status.json" Link="device_status.json" OutputFile="Device_status.cs" ClassName="Device_status" />
    <JsonSchema Include="..\..\..\contracts\json\device.json" Link="device.json" OutputFile="Device.cs" ClassName="Device" ExcludedTypeNames="Device_status" />
    <JsonSchema Include="..\..\..\contracts\json\update_device.json" Link="update_device.json" OutputFile="UpdateDevice.cs" ClassName="UpdateDevice" ExcludedTypeNames="Device_status" />
    <JsonSchema Include="..\..\..\contracts\json\device_changed_message.json" Link="device_changed_message.json" OutputFile="DeviceChangedMessage.cs" ClassName="DeviceChangedMessage" ExcludedTypeNames="Device_status" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NSwag.MSBuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <Import Project="..\..\..\..\build\JsonSchema.targets" />

</Project>
