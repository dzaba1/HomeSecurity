{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DevicesDatabase": "Host=postgres-app;Port=5432;Database=homesecurity_devices;Username=homesecurity;Password=set-via-ConnectionStrings__DevicesDatabase-env-var"
  },
  "Authentication": {
    "Keycloak": {
      "Authority": "http://keycloak:8080/realms/home-security",
      "Audience": "home-security-api"
    }
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://otel-collector:4317"
  }
}
