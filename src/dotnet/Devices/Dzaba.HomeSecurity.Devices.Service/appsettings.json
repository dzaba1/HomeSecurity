{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DevicesDatabase": "Host=postgres-app;Port=5432;Database=homesecurity_devices;Username=homesecurity;Password=set-via-ConnectionStrings__DevicesDatabase-env-var",
    "Redis": "redis:6379",
    "RabbitMQ": "host=rabbitmq;username=set-via-ConnectionStrings__RabbitMQ-env-var;password=set-via-ConnectionStrings__RabbitMQ-env-var"
  },
  "Services": {
    "Org": {
      "BaseUrl": "http://org-service:8080/"
    }
  },
  "PermissionCache": {
    "TtlMinutes": 15
  },
  "Authentication": {
    "Keycloak": {
      "Authority": "http://keycloak:8080/realms/home-security",
      "Audience": "home-security-api"
    }
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://otel-collector:4317"
  }
}
