<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>6f0c3a52-8d4e-4b0a-9c5e-2a7b1f3d9e64</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets Devices.Service.Tests unit-test internal implementation classes
         (DevicesDbContext, its entities, tenancy) directly, not only through
         the public HTTP surface. -->
    <InternalsVisibleTo Include="Dzaba.HomeSecurity.Devices.Service.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Common\Dzaba.HomeSecurity.Domain\Dzaba.HomeSecurity.Domain.csproj" />
    <ProjectReference Include="..\..\Common\Dzaba.HomeSecurity.DomainEvents\Dzaba.HomeSecurity.DomainEvents.csproj" />
    <ProjectReference Include="..\..\Common\Dzaba.HomeSecurity.Observability\Dzaba.HomeSecurity.Observability.csproj" />
    <ProjectReference Include="..\..\Common\Dzaba.HomeSecurity.WebApi\Dzaba.HomeSecurity.WebApi.csproj" />
    <ProjectReference Include="..\..\Common\Dzaba.HomeSecurity.Authorization\Dzaba.HomeSecurity.Authorization.csproj" />
    <ProjectReference Include="..\..\Common\Dzaba.HomeSecurity.DeviceAuth\Dzaba.HomeSecurity.DeviceAuth.csproj" />
    <ProjectReference Include="..\..\Common\Dzaba.HomeSecurity.DbServer\Dzaba.HomeSecurity.DbServer.csproj" />
    <ProjectReference Include="..\..\Common\Dzaba.HomeSecurity.Caching.Redis\Dzaba.HomeSecurity.Caching.Redis.csproj" />
    <ProjectReference Include="..\..\Common\Dzaba.HomeSecurity.Authorization.OrgApi\Dzaba.HomeSecurity.Authorization.OrgApi.csproj" />
    <ProjectReference Include="..\Dzaba.HomeSecurity.Devices.Contracts\Dzaba.HomeSecurity.Devices.Contracts.csproj" />
    <ProjectReference Include="..\..\Common\Dzaba.HomeSecurity.MessageBroker.Contracts\Dzaba.HomeSecurity.MessageBroker.Contracts.csproj" />
    <ProjectReference Include="..\..\Common\Dzaba.HomeSecurity.MessageBroker.RabbitMQ\Dzaba.HomeSecurity.MessageBroker.RabbitMQ.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <PackageReference Include="Dzaba.Utils.AspNet" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

</Project>
