{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "RabbitMQ": "host=rabbitmq;username=set-via-ConnectionStrings__RabbitMQ-env-var;password=set-via-ConnectionStrings__RabbitMQ-env-var"
  },
  "Authentication": {
    "DeviceTokens": {
      "Audience": "home-security-logs-ingestion",
      "SigningKey": "set-via-Authentication__DeviceTokens__SigningKey-env-var"
    }
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://otel-collector:4317"
  }
}
