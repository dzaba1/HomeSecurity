<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <JsonSchema Include="..\..\..\contracts\json\organization.json" Link="organization.json" OutputFile="Organization.cs" ClassName="Organization" />
    <JsonSchema Include="..\..\..\contracts\json\create_organization.json" Link="create_organization.json" OutputFile="CreateOrganization.cs" ClassName="CreateOrganization" />
    <JsonSchema Include="..\..\..\contracts\json\permission.json" Link="permission.json" OutputFile="Permission.cs" ClassName="Permission" />
    <JsonSchema Include="..\..\..\contracts\json\role.json" Link="role.json" OutputFile="Role.cs" ClassName="Role" />
    <JsonSchema Include="..\..\..\contracts\json\create_role.json" Link="create_role.json" OutputFile="CreateRole.cs" ClassName="CreateRole" />
    <JsonSchema Include="..\..\..\contracts\json\membership.json" Link="membership.json" OutputFile="Membership.cs" ClassName="Membership" />
    <JsonSchema Include="..\..\..\contracts\json\create_membership.json" Link="create_membership.json" OutputFile="CreateMembership.cs" ClassName="CreateMembership" />
    <JsonSchema Include="..\..\..\contracts\json\user_role_assignment.json" Link="user_role_assignment.json" OutputFile="UserRoleAssignment.cs" ClassName="UserRoleAssignment" />
    <JsonSchema Include="..\..\..\contracts\json\assign_user_role.json" Link="assign_user_role.json" OutputFile="AssignUserRole.cs" ClassName="AssignUserRole" />
    <JsonSchema Include="..\..\..\contracts\json\access_changed_message.json" Link="access_changed_message.json" OutputFile="AccessChangedMessage.cs" ClassName="AccessChangedMessage" />
    <JsonSchema Include="..\..\..\contracts\json\access_context_response.json" Link="access_context_response.json" OutputFile="AccessContextResponse.cs" ClassName="AccessContextResponse" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NSwag.MSBuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <Import Project="..\..\..\..\build\JsonSchema.targets" />

</Project>
