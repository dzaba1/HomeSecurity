{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AppDatabase": "Host=postgres-app;Port=5432;Database=homesecurity;Username=homesecurity;Password=set-via-ConnectionStrings__AppDatabase-env-var",
    "Redis": "redis:6379"
  },
  "Authentication": {
    "Keycloak": {
      "Authority": "http://keycloak:8080/realms/home-security",
      "Audience": "home-security-api"
    }
  },
  "PermissionCache": {
    "TtlMinutes": 15
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://otel-collector:4317"
  }
}
