<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- EF Core / data (MIT / PostgreSQL license) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.12" />
    <!-- Transitive-only: Npgsql.EntityFrameworkCore.PostgreSQL pulls a lower
         floor than the rest of the EF Core 10.0.12 family requests, so pin it
         explicitly to avoid a resolved-version conflict. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Multi-tenancy: tenant resolution + EF global query filter wiring (Apache-2.0) -->
    <PackageVersion Include="Finbuckle.MultiTenant.AspNetCore" Version="10.1.4" />
    <PackageVersion Include="Finbuckle.MultiTenant.EntityFrameworkCore" Version="10.1.4" />
    <!-- Auth / JWT (MIT) -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageVersion Include="Keycloak.Net.Core" Version="1.0.41" />
    <!-- Caching (MIT) -->
    <PackageVersion Include="StackExchange.Redis" Version="3.3.0" />
    <!-- Messaging: RabbitMQ client, ADR-0007 (MIT) -->
    <PackageVersion Include="EasyNetQ" Version="8.1.7" />
    <!-- Service-to-service HttpClient resilience: retry/circuit breaker via the
         standard resilience handler (built on Polly) rather than hand-rolled
         retry logic (MIT) -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <!-- Health check abstractions/registration (IHealthCheck, AddHealthChecks)
         for non-Web SDK class libraries - Org.Service gets these for free
         from the Microsoft.NET.Sdk.Web shared framework, but
         Dzaba.HomeSecurity.MessageBroker.RabbitMQ is a plain class library. -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.12" />
    <!-- Logging (Serilog, per CLAUDE.md) (Apache-2.0) -->
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <!-- Observability: OpenTelemetry, ADR-0009 (Apache-2.0) -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <!-- Observability: health checks, ADR-0009 (Apache-2.0) -->
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
    <!-- API versioning, ADR-0012 (Apache-2.0) -->
    <!-- Asp.Versioning.Http is newer than Asp.Versioning.Mvc's own release train
         (10.2.3 vs 10.2.1) - the packages aren't released in lockstep, and
         Mvc's dependency on Http is a >= floor, so pinning the transitive dep
         to its own latest is safe. -->
    <PackageVersion Include="Asp.Versioning.Http" Version="10.2.3" />
    <PackageVersion Include="Asp.Versioning.Mvc" Version="10.2.1" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
    <PackageVersion Include="Asp.Versioning.Abstractions" Version="10.2.1" />
    <!-- Contract codegen (MIT) -->
    <PackageVersion Include="NSwag.MSBuild" Version="14.7.1" />
    <!-- Ready-made utilities (CLAUDE.md: prefer Dzaba.Utils over hand-rolled equivalents) (MIT) -->
    <PackageVersion Include="Dzaba.Utils.AspNet" Version="1.1.0" />
    <!-- Transitive-only: Dzaba.Utils.AspNet floors on Newtonsoft.Json 9.0.1,
         which NuGet's audit flags as a known high-severity vulnerability
         (GHSA-5crp-9r3c-p9vr). Other services only pass because something
         else in their graph (e.g. EF Core Design's build host) incidentally
         resolves it higher; pin explicitly rather than rely on that. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <!--
      Testing.
      FluentAssertions is deliberately pinned at 7.2.2, the last version
      under the Apache-2.0 license - 8.0+ moved to a paid/commercial license
      (nuspec license type flips from an SPDX expression to a bundled
      LICENSE file), which doesn't fit this project's licensing.
    -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Dzaba.TestUtils.Integration" Version="1.1.0" />
    <PackageVersion Include="Dzaba.TestUtils" Version="2.0.1" />
    <PackageVersion Include="Dzaba.TestUtils.Integration.AspNet" Version="1.1.0" />
    <!-- AutoFixtureTestFixture/TestFixture/FreezeMock (Dzaba.TestUtils) build
         on AutoFixture + Moq to auto-wire a SUT's constructor dependencies
         as mocks. -->
    <PackageVersion Include="AutoFixture" Version="4.18.1" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <!-- API docs (MIT) -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>
</Project>