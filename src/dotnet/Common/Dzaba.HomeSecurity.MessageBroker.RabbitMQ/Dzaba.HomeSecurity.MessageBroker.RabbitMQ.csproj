<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the tests construct the internal health check directly, and lets
         Moq/Castle's dynamic proxy for ILogger<RabbitMqHealthCheck> reference
         that internal type as a generic argument. -->
    <InternalsVisibleTo Include="Dzaba.HomeSecurity.MessageBroker.RabbitMQ.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <!-- BackgroundService for the subscription (Microsoft.Extensions.Hosting)
         comes with the shared framework, as in Authorization/DomainEvents. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dzaba.HomeSecurity.MessageBroker.Contracts\Dzaba.HomeSecurity.MessageBroker.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EasyNetQ" />
  </ItemGroup>

</Project>
