{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Permission",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for the permission"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "description": "Name of the permission"
    },
    "description": {
      "type": "string",
      "maxLength": 1024,
      "description": "Description of the permission"
    }
  },
  "required": [
    "id",
    "name"
  ],
  "additionalProperties": false
}
