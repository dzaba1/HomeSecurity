{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Role",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for the permission"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Name of the role"
    },
    "organizationId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for the organization"
    },
    "isInternal": {
      "type": "boolean",
      "default": false,
      "description": "Indicates if the role is internal (system-defined) and users can't modify it."
    }
  },
  "required": [
    "id",
    "organizationId",
    "name",
    "isInternal"
  ],
  "additionalProperties": false
}
